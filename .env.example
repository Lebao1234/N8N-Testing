# =============================================================================
# Copy file này thành .env rồi điền giá trị:   cp .env.example .env
# File .env đã nằm trong .gitignore — KHÔNG commit.
# =============================================================================

# ---------- Phiên bản n8n (pin cụ thể, không dùng latest) ----------
# Xem bản stable: https://github.com/n8n-io/n8n/releases
N8N_VERSION=2.45.4

# ---------- PostgreSQL ----------
POSTGRES_USER=n8n
# Sinh password: openssl rand -base64 24 | tr -d '/+='
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=n8n

# ---------- Mã hoá credential của n8n (BẮT BUỘC) ----------
# Sinh bằng:  openssl rand -hex 32
# CẢNH BÁO: đổi key này sau khi đã tạo credential => n8n KHÔNG giải mã được credential cũ.
#           Hãy lưu key ở nơi an toàn (password manager).
N8N_ENCRYPTION_KEY=

# ---------- n8n Public API key (cho n8n-mcp / trợ lý AI) ----------
# Không sinh bằng lệnh — tạo trong UI sau khi có owner account:
#   http://localhost:5678 -> Settings -> n8n API -> Create an API key
# Sau đó dán vào đây VÀ export ra biến môi trường của shell chạy Claude Code (xem README).
N8N_API_KEY=

# ---------- API key LLM cloud (TÙY CHỌN) ----------
# Không truyền vào container. `make import` sẽ tự tạo Credentials tương ứng trong n8n
# (mã hoá bằng N8N_ENCRYPTION_KEY) nếu biến có giá trị.
# OpenAI:    https://platform.openai.com/api-keys            (dạng sk-...)
OPENAI_API_KEY=
# Anthropic: https://console.anthropic.com/settings/keys     (dạng sk-ant-...)
ANTHROPIC_API_KEY=
# Gemini:    https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ---------- Google OAuth (Sheets + Drive) cho workflow JD ----------
# Tạo OAuth Client (Web application) tại https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:5678/rest/oauth2-credential/callback
# Bật API: Google Sheets API, Google Drive API.
# KHÔNG tự import: dán 2 giá trị này vào credential "Google Sheets OAuth2" và
# "Google Drive OAuth2" trong UI rồi bấm "Sign in with Google" (xem jd-automation/README.md).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---------- Đăng bài (jd-05-publish) — CHỈ để tra cứu, KHÔNG được import tự động ----------
# Token truy cập luôn nhập vào n8n Credentials (mã hoá). Xem jd-automation/README-publish.md mục 3.
# LinkedIn app: https://www.linkedin.com/developers/apps (Share on LinkedIn + OpenID Connect)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Meta app (Threads + Facebook Page): https://developers.facebook.com/apps
META_APP_ID=
META_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
# Telegram bot (thông báo duyệt / cảnh báo / đăng tay Facebook Groups): @BotFather
TELEGRAM_BOT_TOKEN=

# ---------- Ollama ----------
# Danh sách model sẽ pull bằng `make models` (cách nhau bằng dấu cách)
OLLAMA_MODELS="llama3.2 nomic-embed-text"

# ---------- Port phía host (đổi nếu bị chiếm; port n8n cố định 5678) ----------
POSTGRES_HOST_PORT=15432
QDRANT_HOST_PORT=6333
OLLAMA_HOST_PORT=11434
