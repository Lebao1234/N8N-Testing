      "parameters": {
        "jsCode": "// Tài liệu mẫu — thay bằng Read Files (/files/...), Google Drive, Notion...\nconst docs = [\n  { title: 'Chính sách đổi trả', text: 'Khách hàng được đổi trả sản phẩm trong vòng 7 ngày kể từ ngày nhận hàng nếu sản phẩm còn nguyên tem, chưa qua sử dụng. Thực phẩm đã mở bao bì không được đổi trả.' },\n  { title: 'Phí vận chuyển', text: 'Miễn phí vận chuyển cho đơn hàng từ 500.000 đồng trong nội thành TP.HCM và Hà Nội. Đơn dưới 500.000 đồng phí ship 30.000 đồng. Các tỉnh khác phí ship 45.000 đồng.' },\n  { title: 'Giờ làm việc', text: 'Cửa hàng mở cửa từ 8h00 đến 21h00 tất cả các ngày trong tuần, kể cả cuối tuần. Hotline hỗ trợ 1900 1234 hoạt động từ 8h00 đến 18h00.' },\n  { title: 'Thanh toán', text: 'Hỗ trợ thanh toán COD, chuyển khoản ngân hàng, ví MoMo và ZaloPay. Đơn hàng trên 2 triệu đồng bắt buộc chuyển khoản trước 30%.' }\n];\nreturn docs.map(d => ({ json: d }));"
