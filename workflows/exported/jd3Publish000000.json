    {
      "parameters": {
        "jsCode": "  // JD = Published khi mọi nền tảng đã đăng; Partially Published khi mới đăng một phần.\n  const touched = new Set($('[Publish] Pick due posts').all().map((i) => i.json.jd_id));\n  const rows = $input.all().map((i) => i.json).filter((r) => touched.has(r.jd_id));\n  const DONE = ['Published', 'Published (manual)'];\n  const byJd = {};\n  for (const r of rows) (byJd[r.jd_id] ??= []).push(r);\n  return Object.entries(byJd).flatMap(([jd_id, list]) => {\n    const done = list.filter((r) => DONE.includes(r.status)).length;\n    if (!done) return [];\n    return [{ json: { jd_id, status: done === list.length ? 'Published' : 'Partially Published', step: `publish ${done}/${list.length}` } }];\n  });"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1780,
        260
      ],
